{
  "name": "portfolio-website",
  "type": "module",
  "description": "A repo that hosts my portfolio website code.",
  "private": true,
  "homepage": "https://github.com/RaduAvramescu/portfolio-website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
