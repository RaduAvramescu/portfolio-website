  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@iconify-json/devicon": "^1.2.80",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.162.0"
