---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
// No props needed for static navbar
---

<!-- Keep mobile fragment destinations clear until scripted menu closing is ready. -->
<header
  id="header"
  class="relative lg:fixed data-[navigation-enhanced]:fixed top-0 left-0 w-full z-50 motion-safe:transition-transform motion-safe:duration-300 ease-in-out"
>
  <nav class="bg-surface text-ink border-b border-edge px-4 py-3">
    <div class="flex items-center justify-between gap-2">
      <a
        class="text-lg font-bold uppercase text-heading hover:text-action motion-safe:transition-colors motion-safe:duration-300"
        href="#top"
        id="navbar-brand"
      >
        Radu Avramescu
      </a>

      <!-- Native disclosure keeps mobile navigation usable without scripts. -->
      <details class="lg:hidden order-3 group/menu" id="mobile-navigation">
        <summary
          class="flex flex-col space-y-1 p-2 rounded-lg hover:bg-section cursor-pointer list-none [&::-webkit-details-marker]:hidden"
          id="mobile-menu-button"
          aria-label="Toggle navigation"
          aria-controls="mobile-menu"
        >
          <span
            class="w-6 h-0.5 bg-ink motion-safe:transition-all motion-safe:duration-300 group-open/menu:rotate-45 group-open/menu:translate-y-1.5"
            aria-hidden="true"></span>
          <span
            class="w-6 h-0.5 bg-ink motion-safe:transition-all motion-safe:duration-300 group-open/menu:opacity-0"
            aria-hidden="true"></span>
          <span
            class="w-6 h-0.5 bg-ink motion-safe:transition-all motion-safe:duration-300 group-open/menu:-rotate-45 group-open/menu:-translate-y-1.5"
            aria-hidden="true"></span>
        </summary>

        <div
          class="absolute top-full inset-x-0 bg-surface border-b border-edge px-4 pt-4 pb-3"
          id="mobile-menu"
        >
          <ul class="flex flex-col space-y-2">
            <li>
              <a
                class="nav-link block py-2 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300"
                href="#top"
              >
                Home
              </a>
            </li>
            <li>
              <a
                class="nav-link block py-2 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300"
                href="#projects"
              >
                Projects
              </a>
            </li>
            <li>
              <a
                class="nav-link block py-2 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300"
                href="#about"
              >
                About
              </a>
            </li>
            <li>
              <a
                class="nav-link block py-2 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300"
                href="#contact"
              >
                Contact
              </a>
            </li>
          </ul>
        </div>
      </details>

      <!-- Desktop navigation -->
      <ul class="hidden lg:flex space-x-8 ml-auto">
        <li>
          <a
            class="nav-link relative px-0 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300 after:content-[''] after:absolute after:w-0 after:h-0.5 after:-bottom-1.5 after:left-1/2 after:bg-action motion-safe:after:transition-all motion-safe:after:duration-300 after:ease-in-out after:-translate-x-1/2 hover:after:w-full"
            href="#top"
          >
            Home
          </a>
        </li>
        <li>
          <a
            class="nav-link relative px-0 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300 after:content-[''] after:absolute after:w-0 after:h-0.5 after:-bottom-1.5 after:left-1/2 after:bg-action motion-safe:after:transition-all motion-safe:after:duration-300 after:ease-in-out after:-translate-x-1/2 hover:after:w-full"
            href="#projects"
          >
            Projects
          </a>
        </li>
        <li>
          <a
            class="nav-link relative px-0 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300 after:content-[''] after:absolute after:w-0 after:h-0.5 after:-bottom-1.5 after:left-1/2 after:bg-action motion-safe:after:transition-all motion-safe:after:duration-300 after:ease-in-out after:-translate-x-1/2 hover:after:w-full"
            href="#about"
          >
            About
          </a>
        </li>
        <li>
          <a
            class="nav-link relative px-0 font-medium text-muted uppercase hover:text-action motion-safe:transition-colors motion-safe:duration-300 after:content-[''] after:absolute after:w-0 after:h-0.5 after:-bottom-1.5 after:left-1/2 after:bg-action motion-safe:after:transition-all motion-safe:after:duration-300 after:ease-in-out after:-translate-x-1/2 hover:after:w-full"
            href="#contact"
          >
            Contact
          </a>
        </li>
      </ul>
      <div class="ml-auto lg:ml-4">
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<!-- Scroll to top button -->
<a
  href="#top"
  id="scroll-to-top"
  class="fixed bottom-5 right-5 z-50 bg-surface rounded-full text-action shadow-md no-underline flex items-center justify-center opacity-0 motion-safe:transition-all motion-safe:duration-300 hover:text-action-hover"
  aria-label="Scroll to top"
>
  <Icon name="mdi:chevron-up-circle" width={48} height={48} />
</a>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let prevScrollPos = window.scrollY;
    const header = document.getElementById('header');
    const scrollToTopBtn = document.getElementById('scroll-to-top');
    const mobileNavigation =
      document.querySelector<HTMLDetailsElement>('#mobile-navigation');
    const mobileMenuButton = document.getElementById('mobile-menu-button');

    if (!header || !scrollToTopBtn) {
      return;
    }

    function closeMenu() {
      if (mobileNavigation) mobileNavigation.open = false;
    }

    header.addEventListener('keydown', event => {
      if (event.key === 'Escape' && mobileNavigation?.open) {
        closeMenu();
        mobileMenuButton?.focus();
      }
    });
    header.addEventListener('focusin', () => {
      header.classList.remove('-translate-y-full');
    });

    // Measure the closed header, even while the mobile menu is expanded.
    const nav = header.querySelector('nav');
    const navRow = nav?.firstElementChild;
    if (nav && navRow) {
      const updateHeaderOffset = () => {
        const style = getComputedStyle(nav);
        const height =
          navRow.getBoundingClientRect().height +
          parseFloat(style.paddingTop) +
          parseFloat(style.paddingBottom) +
          parseFloat(style.borderTopWidth) +
          parseFloat(style.borderBottomWidth);
        document.documentElement.style.setProperty(
          '--header-height',
          `${height}px`
        );
      };
      updateHeaderOffset();
      new ResizeObserver(updateHeaderOffset).observe(navRow);
    }

    // Reset both visual and announced state when switching to desktop navigation.
    window
      .matchMedia('(min-width: 64rem)')
      .addEventListener('change', event => {
        if (event.matches) closeMenu();
      });

    function handleScroll() {
      const currentScrollPos = window.scrollY;
      const isVisible =
        prevScrollPos > currentScrollPos || currentScrollPos < 10;
      header!.classList.toggle('-translate-y-full', !isVisible);
      if (!isVisible) closeMenu();
      scrollToTopBtn!.classList.toggle('!opacity-100', currentScrollPos > 100);
      prevScrollPos = currentScrollPos;
    }

    // Include the brand and other page anchors, while preserving modified clicks.
    document
      .querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
      .forEach(link => {
        link.addEventListener('click', event => {
          if (
            event.button !== 0 ||
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          )
            return;
          closeMenu();
        });
      });

    window.addEventListener('scroll', handleScroll, { passive: true });

    closeMenu();
    header.dataset.navigationEnhanced = '';
  });
</script>
