---
import Technologies from './Technologies.astro';
import { Icon } from 'astro-icon/components';
import { getImageSources } from '../utils/imageImports';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  data: CollectionEntry<'projects'>['data'];
  delay: number;
}

const { data, delay } = Astro.props;
const { webp, jpg } = getImageSources(data.image);

const getDelayClass = (index: number) => {
  const delays = [
    '',
    'delay-100',
    'delay-200',
    'delay-300',
    'delay-500',
    'delay-700',
  ];
  return delays[index] || 'delay-1000';
};
---

<div
  class={`mb-8 ${getDelayClass(delay)}`}
  data-observe="true"
  data-trigger-once="true"
>
  <div
    class="bg-surface border-2 border-edge rounded-lg h-full flex flex-col overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300"
  >
    <div class="overflow-hidden p-0 bg-surface">
      <a target="_blank" href={data.demoURL} rel="noreferrer">
        <picture>
          <source type="image/webp" srcset={webp} />
          <img
            src={jpg}
            alt={data.title}
            class="w-full h-64 object-cover rounded-t-lg transition-transform duration-300 hover:scale-[1.3]"
            width="450"
            height="250"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
    </div>
    <div class="p-6 flex flex-col flex-grow bg-surface">
      <h3 class="font-bold text-xl uppercase mb-4 text-ink tracking-wide">
        {data.title}
      </h3>
      <p class="text-muted flex-grow mb-4">{data.description}</p>
      <p class="font-bold uppercase text-ink mb-3">Technologies Used</p>
      <div class="mb-4 flex flex-wrap justify-center gap-2">
        <Technologies technologies={data.technologies} width={40} />
      </div>
    </div>
    <div class="border-0 bg-surface p-6 pt-0">
      <div class="flex justify-around space-x-4">
        <a
          target="_blank"
          class="group flex items-center border-2 border-action text-ink hover:bg-action hover:text-action-ink hover:shadow-lg hover:shadow-black/15 font-bold px-4 py-2 rounded-lg transition-all duration-300 flex-1 justify-center"
          href={data.demoURL}
          rel="noreferrer"
        >
          <span class="uppercase mr-2 tracking-widest">Demo</span>
          <Icon
            name="mdi:rocket-launch"
            class="w-5 h-5 transition-transform duration-300"
          />
        </a>
        <a
          target="_blank"
          class="group flex items-center border-2 border-action text-ink hover:bg-action hover:text-action-ink hover:shadow-lg hover:shadow-black/15 font-bold px-4 py-2 rounded-lg transition-all duration-300 flex-1 justify-center"
          href={data.codeURL}
          rel="noreferrer"
        >
          <span class="uppercase mr-2 tracking-widest">Code</span>
          <Icon
            name="mdi:github"
            class="w-5 h-5 transition-transform duration-300"
          />
        </a>
      </div>
    </div>
  </div>
</div>
