---
import Technologies from './Technologies.astro';
import type { Technology } from '../utils/technologies';

const technologies: Technology[] = [
  'HTML5',
  'CSS3',
  'Tailwind CSS',
  'Material-UI',
  'JavaScript',
  'React',
  'Astro',
  'GraphQL',
  'Git',
  'npm',
];
---

<section
  id="about"
  class="scroll-mt-[calc(var(--header-height)+1rem)] bg-section text-ink border-y border-edge py-10 px-5 md:py-14 md:px-4 text-center"
>
  <h2
    class="text-4xl font-bold uppercase text-heading mb-12"
    data-observe="true"
    data-trigger-once="true"
  >
    About
  </h2>
  <h3
    class="max-w-4xl mx-auto text-xl text-muted leading-relaxed mb-12 text-balance"
    data-observe="true"
    data-trigger-once="true"
  >
    I'm a frontend developer interested in staying up to date with technologies
    and constantly learning. Below is a collection of the technologies I use.
  </h3>
  <div data-observe="true" data-trigger-once="true">
    <div
      id="technology-strip"
      class="mx-auto flex overflow-hidden w-full max-w-4xl group motion-reduce:overflow-visible"
    >
      {
        [false, true].map(duplicate => (
          <div
            class:list={[
              'flex items-center shrink-0 w-max motion-safe:animate-scroll-left-sm motion-safe:sm:animate-scroll-left-md motion-safe:md:animate-scroll-left group-hover:[animation-play-state:paused] motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:justify-center',
              { 'motion-reduce:hidden': duplicate },
            ]}
            aria-hidden={duplicate ? 'true' : undefined}
          >
            <Technologies technologies={technologies} width={70} />
          </div>
        ))
      }
    </div>
  </div>
</section>
