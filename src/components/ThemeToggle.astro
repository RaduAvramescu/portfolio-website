---
import { Icon } from 'astro-icon/components';
---

<button
  id="theme-toggle"
  type="button"
  hidden
  aria-label="Switch color theme"
  class="theme-toggle shrink-0 items-center justify-center size-11 rounded-lg border border-control text-action hover:bg-section hover:text-action-hover cursor-pointer motion-safe:transition-colors"
>
  <span class="theme-icon-light" aria-hidden="true">
    <Icon name="mdi:weather-sunny" width={24} height={24} />
  </span>
  <span class="theme-icon-dark" aria-hidden="true">
    <Icon name="mdi:weather-night" width={24} height={24} />
  </span>
</button>

<style>
  .theme-toggle:not([hidden]) {
    display: flex;
  }

  .theme-icon-light,
  :global([data-theme='dark']) .theme-icon-dark {
    display: none;
  }

  :global([data-theme='dark']) .theme-icon-light {
    display: block;
  }
</style>
