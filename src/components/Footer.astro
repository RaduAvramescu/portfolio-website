---
// Footer component for Astro
import { Icon } from 'astro-icon/components';
---

<footer class="bg-section text-ink border-t border-edge" id="footer">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-4 text-center">
    <p class="mb-6 text-muted text-sm">
      &copy; 2026 Radu Avramescu. All rights reserved.
    </p>
    <div class="flex justify-center gap-2">
      <a
        target="_blank"
        href="https://github.com/RaduAvramescu"
        aria-label="GitHub"
        rel="noreferrer"
        class="text-muted hover:text-action no-underline inline-block transition-all duration-300 hover:scale-110"
      >
        <Icon
          name="mdi:github"
          width="48"
          height="48"
          class="transition-transform duration-300"
        />
      </a>
      <a
        target="_blank"
        href="https://www.linkedin.com/in/radu-a-4863a486/"
        aria-label="LinkedIn"
        rel="noreferrer"
        class="text-muted hover:text-action no-underline inline-block transition-all duration-300 hover:scale-110"
      >
        <Icon
          name="mdi:linkedin"
          width="48"
          height="48"
          class="transition-transform duration-300"
        />
      </a>
    </div>
  </div>
</footer>
