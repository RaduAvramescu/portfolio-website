---
import { Icon } from 'astro-icon/components';
import { technologyIconMap, type Technology } from '../utils/technologies';

export interface Props {
  techName: Technology;
  width?: number;
}

const { techName, width = 40 } = Astro.props;
const className = width > 50 ? 'mx-4 my-2' : 'm-1';

const iconName = technologyIconMap[techName];
---

<Icon
  name={iconName}
  class={`${className} ${techName === 'Astro' ? 'technology-astro' : ''} shrink-0 text-ink transition-transform duration-300 hover:scale-120`}
  width={width}
  height={width}
  title={techName}
/>

<style>
  /* Let Astro's letter follow the theme while preserving its colored flame. */
  :global(.technology-astro path:first-of-type) {
    fill: currentColor;
  }
</style>
