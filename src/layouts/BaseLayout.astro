---
import '../styles/globals.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../components/ThemeScript.astro';

export interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Frontend Developer - Portfolio showcasing modern web development projects',
  noIndex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/social-preview.png', Astro.site);
const socialImageAlt = 'Radu Avramescu, Frontend Developer — raduavramescu.com';
---

<!doctype html>
<html lang="en" class="motion-safe:scroll-smooth [--header-height:4.25rem]">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {
      noIndex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Radu Avramescu" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalUrl.href} />
          <meta property="og:image" content={socialImageUrl.href} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={socialImageAlt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImageUrl.href} />
          <meta name="twitter:image:alt" content={socialImageAlt} />
        </>
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <ClientRouter />
    <ThemeScript />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-open-sans" preload={[{ subset: 'latin' }]} />
    <Font
      cssVariable="--font-source-code-pro"
      preload={[{ subset: 'latin', weight: 700 }]}
    />
    <title>{title}</title>
  </head>
  <body id="top">
    <a
      href="#main-content"
      class="fixed top-3 left-3 z-[60] -translate-y-[200%] rounded-lg bg-action px-4 py-3 font-semibold text-action-ink focus:translate-y-0"
    >
      Skip to main content
    </a>
    <slot />
    <script src="../scripts/navigation.ts"></script>
  </body>
</html>
